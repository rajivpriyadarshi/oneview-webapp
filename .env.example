# Application Environment
NEXT_PUBLIC_APP_ENV=development

# API Configuration
NEXT_PUBLIC_API_BASE_URL=https://labs-sbox.zinc.money/api/wealth
NEXT_PUBLIC_AI_AGENT_SLUG=wealth-advisor

# Google OAuth Configuration
# Get this from Google Cloud Console > APIs & Services > Credentials
# See GOOGLE_AUTH_SETUP.md for detailed setup instructions
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Mixpanel Configuration
# Get this from Mixpanel Project Settings > Project token
NEXT_PUBLIC_MIXPANEL_TOKEN=
# Optional proxy endpoint for Mixpanel requests
NEXT_PUBLIC_MIXPANEL_PROXY_DOMAIN=
# Build/app version marker used in analytics metadata
NEXT_PUBLIC_VERSION=local

# /lab/dynamic-ui — the model that turns an open-ended ask into findings.
# Server-side only, never exposed to the browser. Without it the prototype falls
# back to a local stand-in analyst over the same mock client book.
ANTHROPIC_API_KEY=
# Alternative provider for the same route. Whichever key is present is used,
# Anthropic first. Without either, /lab/dynamic-ui falls back to its local analyst.
OPENAI_API_KEY=
# Optional override, defaults to claude-sonnet-5
DYNAMIC_UI_MODEL=
